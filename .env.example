# Copy only settings you need into your existing PRIVATE .env. Never commit .env.
# Your current Mac defaults continue to work without a DATABASE_URL.
GEMINI_API_KEY=replace-locally
CAUSYN_THINKING_LEVEL=low
# Hosting: use the reader URL, never the database owner/admin URL.
# DATABASE_URL=postgresql://causyn_reader:URL_ENCODED_PASSWORD@HOST:5432/causyn?sslmode=verify-full
# Some providers require sslrootcert=/absolute/path/provider-ca.pem as well.
# Follow the chosen provider's verified TLS connection instructions.
CAUSYN_ENV=local
CAUSYN_LIVE_ENABLED=true
PORT=8765
# Production: HTTPS public origin, random >=24-character access code, persistent runtime volume.
# CAUSYN_ENV=production
# CAUSYN_PUBLIC_ORIGIN=https://your-domain.example
# CAUSYN_ACCESS_CODE=generate-a-private-random-code
# CAUSYN_RUNTIME_DIR=/runtime
CAUSYN_DAILY_LIVE_LIMIT=20
CAUSYN_HOURLY_SESSION_LIMIT=5
